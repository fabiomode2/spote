# Copia este fichero a .env y rellena los secretos.
#   cp .env.example .env && chmod 600 .env
#
# Genera valores aleatorios con:
#   cargo run -p spote-server -- keygen ana bea
#
# Una clave por persona. El nombre de cada amigo queda atado a su clave en el
# primer login: nadie más puede usar ese nombre.
SPOTE_INVITE=cambia-esto-por-una-invitacion-aleatoria-de-32-bytes
SPOTE_CLIENT_KEYS=ana:cambia-esto-por-64-hex,bea:cambia-esto-por-64-hex

# 7070 no se publica al mundo: nginx habla con 127.0.0.1:7070.
SPOTE_BIND=0.0.0.0:7070
SPOTE_DB=/data/spote-server.db
SPOTE_SESSION_DAYS=30
RUST_LOG=info,spote_server=info,tower_http=warn

# Opcional: solo si sirves una web desde otro origen.
# SPOTE_CORS_ORIGIN=https://spote.example.com

# Opcional con Docker secrets, en lugar de las variables de arriba:
# SPOTE_INVITE_FILE=/run/secrets/spote_invite
# SPOTE_CLIENT_KEYS_FILE=/run/secrets/spote_client_keys
